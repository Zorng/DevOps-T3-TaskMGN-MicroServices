# API gateway: public entry point for /api/v1.
# Rendered at container start: ${...} placeholders are filled from environment
# variables (see ../../.env.example). Nginx's own $variables are left untouched.
#
# Implements the route table in api_contracts/gateway-routing.md and the header
# rules in api_contracts/authentication.md. Throttling and metrics are
# tracked in issue #29 / #34.

# Nginx's request ID is 32 hex characters; the contract wants a dashed UUID.
map $request_id $request_uuid {
    "~^(?<u1>[0-9a-f]{8})(?<u2>[0-9a-f]{4})(?<u3>[0-9a-f]{4})(?<u4>[0-9a-f]{4})(?<u5>[0-9a-f]{12})$" "$u1-$u2-$u3-$u4-$u5";
}

# CORS (api_contracts/authentication.md). CORS_ALLOWED_ORIGINS is a regex
# alternation of exact origins, e.g. http://localhost:5173|https://app[.]example[.]com
# $cors_origin is the request's Origin when allowed, otherwise empty (and an
# empty add_header value is not sent at all).
map $http_origin $cors_origin {
    default "";
    "~^(${CORS_ALLOWED_ORIGINS})$" $http_origin;
}

# Only send Access-Control-Expose-Headers to allowed origins.
map $cors_origin $cors_expose {
    default "ETag, X-Request-ID, Retry-After";
    "" "";
}

# Classify an OPTIONS request that carries an Origin: "allowed" or "denied".
map "$request_method $http_origin $cors_origin" $cors_preflight {
    default "";
    "~^OPTIONS \S+ \S+$" allowed;
    "~^OPTIONS \S+ $" denied;
}

server {
    listen 8080;
    server_tokens off;
    default_type application/json;

    # Contract: 64 KiB request-body bound; 10 s upstream timeout; no auto-retry.
    client_max_body_size 64k;
    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout 10s;
    proxy_read_timeout 10s;
    proxy_next_upstream off;

    # Forwarded unchanged: method, path, query, body, Authorization,
    # Idempotency-Key, If-Match. Set a request ID for correlation.
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_uuid;
    add_header X-Request-ID $request_uuid always;

    # CORS headers on every response. The services' own CORS and request-ID
    # headers are dropped so the browser never sees duplicates.
    add_header Vary Origin always;
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Expose-Headers $cors_expose always;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Methods;
    proxy_hide_header Access-Control-Allow-Headers;
    proxy_hide_header Access-Control-Allow-Credentials;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Access-Control-Max-Age;
    proxy_hide_header X-Request-ID;

    # Strip client-supplied service credentials and identity assertions
    # (an empty value removes the header from the upstream request).
    proxy_set_header X-Service-Key "";
    proxy_set_header X-User-ID "";
    proxy_set_header X-User-Role "";
    proxy_set_header X-User-Email "";
    proxy_set_header X-Actor-Role "";

    error_page 403 @origin_not_allowed;
    error_page 405 = @method_not_allowed;
    error_page 413 @payload_too_large;
    error_page 502 504 =503 @dependency_unavailable;

    # Gateway's own liveness probe (not a business route, not proxied).
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Routes match the public OpenAPI operations exactly. Anything else falls
    # through to the 404 below; a known path with the wrong method gets a 405
    # (see @method_not_allowed). Because every pattern is anchored and exact,
    # no route can swallow another, so their order does not matter.

    # ---- Task
    location ~ ^/api/v1/workspaces/[^/]+/(boards|tasks)$ {
        set $allow_methods "GET, POST";
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        proxy_pass ${TASK_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+/(boards|tasks)/[^/]+$ {
        set $allow_methods "GET, PATCH, DELETE";
        if ($request_method !~ ^(GET|PATCH|DELETE)$) { return 405; }
        proxy_pass ${TASK_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+/tasks/[^/]+/comments$ {
        set $allow_methods "GET, POST";
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        proxy_pass ${TASK_UPSTREAM};
    }

    # ---- Identity & Workspace
    # Contract: both login endpoints require an allowed Origin.
    location ~ ^/api/v1/auth/google/(challenges|exchange)$ {
        set $allow_methods "POST";
        if ($request_method != POST) { return 405; }
        if ($cors_origin = "") { return 403; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location = /api/v1/auth/logout {
        set $allow_methods "POST";
        if ($request_method != POST) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location = /api/v1/me {
        set $allow_methods "GET";
        if ($request_method != GET) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location = /api/v1/workspaces {
        set $allow_methods "GET, POST";
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+$ {
        set $allow_methods "GET, PATCH, DELETE";
        if ($request_method !~ ^(GET|PATCH|DELETE)$) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+/members$ {
        set $allow_methods "GET";
        if ($request_method != GET) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+/(members/[^/]+|membership)$ {
        set $allow_methods "DELETE";
        if ($request_method != DELETE) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/workspaces/[^/]+/invitations$ {
        set $allow_methods "GET, POST";
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/invitations(/[^/]+)?$ {
        set $allow_methods "GET";
        if ($request_method != GET) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }
    location ~ ^/api/v1/invitations/[^/]+/(response|cancel)$ {
        set $allow_methods "POST";
        if ($request_method != POST) { return 405; }
        proxy_pass ${IDENTITY_UPSTREAM};
    }

    # ---- Notification
    location ~ ^/api/v1/notifications(/unread-count)?$ {
        set $allow_methods "GET";
        if ($request_method != GET) { return 405; }
        proxy_pass ${NOTIFICATION_UPSTREAM};
    }
    location ~ ^/api/v1/notifications/[^/]+/read$ {
        set $allow_methods "POST";
        if ($request_method != POST) { return 405; }
        proxy_pass ${NOTIFICATION_UPSTREAM};
    }

    # Everything else (including /internal/**, metrics, health of services):
    # never forwarded. Shared error envelope.
    location / {
        return 404 '{"error":{"code":"NOT_FOUND","message":"The requested resource was not found.","request_id":"$request_uuid","details":[]}}';
    }

    # Wrong method, or a CORS preflight. Every route rejects OPTIONS with 405, so
    # this one handler also answers preflights for recognized routes (no session
    # needed). add_header inside a location or if-block replaces the server-level
    # ones, so each branch lists the headers it needs.
    location @method_not_allowed {
        if ($cors_preflight = allowed) {
            add_header X-Request-ID $request_uuid always;
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $cors_origin always;
            add_header Access-Control-Allow-Methods $allow_methods always;
            add_header Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key, If-Match, X-Request-ID" always;
            add_header Access-Control-Max-Age 600 always;
            return 204;
        }
        if ($cors_preflight = denied) {
            add_header X-Request-ID $request_uuid always;
            add_header Vary Origin always;
            return 403 '{"error":{"code":"ORIGIN_NOT_ALLOWED","message":"The request origin is not allowed.","request_id":"$request_uuid","details":[]}}';
        }
        add_header X-Request-ID $request_uuid always;
        add_header Vary Origin always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Expose-Headers $cors_expose always;
        add_header Allow $allow_methods always;
        return 405 '{"error":{"code":"METHOD_NOT_ALLOWED","message":"The HTTP method is not allowed for this resource.","request_id":"$request_uuid","details":[]}}';
    }

    location @origin_not_allowed {
        add_header X-Request-ID $request_uuid always;
        add_header Vary Origin always;
        return 403 '{"error":{"code":"ORIGIN_NOT_ALLOWED","message":"The request origin is not allowed.","request_id":"$request_uuid","details":[]}}';
    }

    location @payload_too_large {
        return 413 '{"error":{"code":"PAYLOAD_TOO_LARGE","message":"The request body is too large.","request_id":"$request_uuid","details":[]}}';
    }

    location @dependency_unavailable {
        add_header X-Request-ID $request_uuid always;
        add_header Vary Origin always;
        add_header Access-Control-Allow-Origin $cors_origin always;
        add_header Access-Control-Expose-Headers $cors_expose always;
        add_header Retry-After 5 always;
        return 503 '{"error":{"code":"DEPENDENCY_UNAVAILABLE","message":"A required service is temporarily unavailable.","request_id":"$request_uuid","details":[]}}';
    }
}
