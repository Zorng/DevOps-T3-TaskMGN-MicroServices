# Placeholder values only. Copy to .env (which Git ignores) and replace every
# value with a long random secret outside local development, e.g.
#   openssl rand -base64 24
BROKER_ADMIN_USER=broker-admin
BROKER_ADMIN_PASSWORD=change-me-admin
BROKER_IDENTITY_PASSWORD=change-me-identity
BROKER_TASK_PASSWORD=change-me-task
BROKER_NOTIFICATION_PASSWORD=change-me-notification

# Host ports (localhost only). Change these if they clash with another stack.
BROKER_AMQP_PORT=5672
BROKER_MGMT_PORT=15672
BROKER_METRICS_PORT=15692
