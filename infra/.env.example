# Placeholder values only. Never commit real secrets.
# Create your local file with:  python3 infra/scripts/setup_env.py
# Every value written as "generate" is replaced with a random secret by that
# script. Git ignores infra/.env and infra/.secrets/.

# --- Public entry point -------------------------------------------------------
# The gateway is the only published port, bound to 127.0.0.1. Change it if
# another program already uses 8080.
GATEWAY_HTTP_PORT=8080
# Browser origins the gateway allows (exact origins joined with |, dots as [.]).
CORS_ALLOWED_ORIGINS=http://localhost:5173|http://127[.]0[.]0[.]1:5173

# --- Identity & Workspace -----------------------------------------------------
IDENTITY_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
# Public Google OAuth web client ID (not a secret). Leave empty to run without
# sign-in: login endpoints then return 503 and session checks are skipped.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_DB_OWNER_PASSWORD=generate
IDENTITY_DB_APP_PASSWORD=generate
# Identity gives Task and Notification each their own key (43 to 128 URL-safe
# characters). Task receives the first one; Notification is not built yet.
IDENTITY_TASK_SERVICE_KEY=generate
IDENTITY_NOTIFICATION_SERVICE_KEY=generate

# --- Task ---------------------------------------------------------------------
TASK_DB_USERNAME=task_app
TASK_DB_PASSWORD=generate
# At least 32 bytes, identical across Task instances.
TASK_CURSOR_SECRET=generate

# --- Broker (RabbitMQ) --------------------------------------------------------
BROKER_ADMIN_USER=broker-admin
BROKER_ADMIN_PASSWORD=generate
BROKER_IDENTITY_PASSWORD=generate
BROKER_TASK_PASSWORD=generate
BROKER_NOTIFICATION_PASSWORD=generate