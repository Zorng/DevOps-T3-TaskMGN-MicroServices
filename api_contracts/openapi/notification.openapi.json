{
  "openapi": "3.1.1",
  "info": {
    "title": "Notification API",
    "version": "1.0.0",
    "description": "Implementation contract draft for team review. Work area: Notification. See ../conventions.md, ../authentication.md, and ../workflows.md. All examples are synthetic."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local gateway; replace with HTTPS gateway in deployed environment."
    }
  ],
  "security": [
    {
      "sessionBearer": []
    }
  ],
  "paths": {
    "/api/v1/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "List my notifications",
        "description": "Authenticate through private Identity introspection; derive recipient from session, never a query parameter. created_at DESC then id DESC. Generic event metadata only, no task titles/bodies or invitation email.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "unread_only",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPage"
                },
                "example": {
                  "items": [
                    {
                      "id": "00000000-0000-4000-8000-000000000011",
                      "event_id": "00000000-0000-4000-8000-000000000102",
                      "type": "assignment",
                      "actor": {
                        "id": "00000000-0000-4000-8000-000000000001",
                        "display_name": "Example Owner"
                      },
                      "workspace_id": "00000000-0000-4000-8000-000000000003",
                      "invitation_id": null,
                      "task_id": "00000000-0000-4000-8000-000000000006",
                      "comment_id": null,
                      "occurred_at": "2026-11-14T10:00:00Z",
                      "created_at": "2026-11-14T10:00:00Z",
                      "read_at": null
                    }
                  ],
                  "next_cursor": null
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "tags": [
          "Notification API"
        ]
      }
    },
    "/api/v1/notifications/unread-count": {
      "get": {
        "operationId": "getUnreadCount",
        "summary": "Get my unread count",
        "description": "Exact count for current recipient at read time.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnreadCount"
                },
                "example": {
                  "count": 1
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        },
        "tags": [
          "Notification API"
        ]
      }
    },
    "/api/v1/notifications/{notification_id}/read": {
      "post": {
        "operationId": "markNotificationRead",
        "summary": "Mark my notification read",
        "description": "Recipient only. First call sets read_at; repeats preserve it. Other recipient: 404. No request body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/notification_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Notification"
                },
                "example": {
                  "id": "00000000-0000-4000-8000-000000000011",
                  "event_id": "00000000-0000-4000-8000-000000000102",
                  "type": "assignment",
                  "actor": {
                    "id": "00000000-0000-4000-8000-000000000001",
                    "display_name": "Example Owner"
                  },
                  "workspace_id": "00000000-0000-4000-8000-000000000003",
                  "invitation_id": null,
                  "task_id": "00000000-0000-4000-8000-000000000006",
                  "comment_id": null,
                  "occurred_at": "2026-11-14T10:00:00Z",
                  "created_at": "2026-11-14T10:00:00Z",
                  "read_at": "2026-11-14T10:01:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          },
          "422": {
            "$ref": "#/components/responses/422"
          }
        },
        "tags": [
          "Notification API"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "Notificationlive",
        "summary": "Service live",
        "description": "Process responds; does not test dependencies.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "unavailable"
                }
              }
            }
          }
        },
        "tags": [
          "Notification API"
        ],
        "security": []
      },
      "servers": [
        {
          "url": "http://notification:8002",
          "description": "Private direct service probe; not exposed by public gateway."
        }
      ]
    },
    "/health/ready": {
      "get": {
        "operationId": "Notificationready",
        "summary": "Service ready",
        "description": "Can serve required synchronous operations: database available; Task/Notification can reach Identity. Broker outage alone does not fail readiness if outbox can safely persist. 503 when unavailable.",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Correlation UUID."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          },
          "503": {
            "description": "Success.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
