            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Correlation UUID."
          },
          "Cache-Control": {
            "schema": {
              "type": "string"
            },
            "description": "no-store"
          }
        },
        "content": {
          "application/json": {
            "schema": {
