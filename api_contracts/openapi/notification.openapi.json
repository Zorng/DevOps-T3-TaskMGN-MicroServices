      "412": {
        "description": "If-Match version is stale.",
        "headers": {
          "X-Request-ID": {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Correlation UUID."
          },
          "Cache-Control": {
            "schema": {
              "type": "string"
            },
            "description": "no-store"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
