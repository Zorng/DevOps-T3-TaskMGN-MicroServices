  "components": {
    "securitySchemes": {
      "sessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque application session issued by Google exchange; NOT a Google ID token."
      },
      "serviceKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Key",
        "description": "Per-caller secret. Task and Notification have distinct keys and endpoint allowlists."
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Optional correlation UUID; gateway generates/replaces invalid values and echoes a UUID."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Client-generated UUID; retain the same value on retry. Scope and 24-hour retention: conventions.md."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        },
        "description": "Strong version ETag, e.g. \"3\". Required on resource PATCH/DELETE. Stale: 412; missing: 428."
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "description": "Opaque cursor from the same list, user, and filters. Invalid cursor: 400."
      },
      "workspace_id": {
        "name": "workspace_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "board_id": {
        "name": "board_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "task_id": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "invitation_id": {
        "name": "invitation_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "notification_id": {
        "name": "notification_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "user_id": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "UserSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "id": "00000000-0000-4000-8000-000000000001",
            "display_name": "Example Owner"
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 150
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "field",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "code",
              "message",
              "request_id",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "error": {
              "code": "VALIDATION_FAILED",
              "message": "The request contains invalid fields.",
              "request_id": "00000000-0000-4000-8000-000000000012",
              "details": [
                {
                  "field": "due_date",
                  "reason": "Must be on or after start_date."
                }
              ]
            }
          }
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "invitation",
              "assignment",
              "mention"
            ]
          },
          "actor": {
            "$ref": "#/components/schemas/UserSummary"
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid"
          },
          "invitation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "comment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "read_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "event_id",
          "type",
          "actor",
          "workspace_id",
          "invitation_id",
          "task_id",
          "comment_id",
          "occurred_at",
          "created_at",
          "read_at"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "id": "00000000-0000-4000-8000-000000000011",
            "event_id": "00000000-0000-4000-8000-000000000102",
            "type": "assignment",
            "actor": {
              "id": "00000000-0000-4000-8000-000000000001",
              "display_name": "Example Owner"
            },
            "workspace_id": "00000000-0000-4000-8000-000000000003",
            "invitation_id": null,
            "task_id": "00000000-0000-4000-8000-000000000006",
            "comment_id": null,
            "occurred_at": "2026-11-14T10:00:00Z",
            "created_at": "2026-11-14T10:00:00Z",
            "read_at": null
          }
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "status": "ok"
          }
        ]
      },
      "UnreadCount": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "count"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "count": 1
          }
        ]
      },
      "NotificationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            },
            "maxItems": 100
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "items": [
              {
                "id": "00000000-0000-4000-8000-000000000011",
                "event_id": "00000000-0000-4000-8000-000000000102",
                "type": "assignment",
                "actor": {
                  "id": "00000000-0000-4000-8000-000000000001",
                  "display_name": "Example Owner"
                },
                "workspace_id": "00000000-0000-4000-8000-000000000003",
                "invitation_id": null,
                "task_id": "00000000-0000-4000-8000-000000000006",
                "comment_id": null,
                "occurred_at": "2026-11-14T10:00:00Z",
                "created_at": "2026-11-14T10:00:00Z",
                "read_at": null
              }
            ],
            "next_cursor": null
          }
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Malformed JSON, parameter, or cursor.",
        "headers": {
          "X-Request-ID": {
            "schema": {
              "type": "string",
              "format": "uuid"
