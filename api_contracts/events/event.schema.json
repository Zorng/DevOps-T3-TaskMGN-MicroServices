              ]
            }
          },
          "required": [
            "workspace_id",
            "user_id",
            "membership_id",
            "actor",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "schema_version",
        "producer",
        "occurred_at",
        "request_id",
