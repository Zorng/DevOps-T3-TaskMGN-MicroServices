        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "membership_id": {
              "type": "string",
              "format": "uuid"
            },
            "actor": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "display_name"
              ],
              "additionalProperties": false
            },
            "reason": {
              "type": "string",
              "enum": [
                "removed",
