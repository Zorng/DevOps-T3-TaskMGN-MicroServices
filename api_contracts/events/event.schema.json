        "aggregate_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "data": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid"
            },
            "task_id": {
              "type": "string",
              "format": "uuid"
            },
            "comment_id": {
              "type": "string",
              "format": "uuid"
            },
            "actor": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "display_name"
              ],
              "additionalProperties": false
            },
            "recipient_id": {
              "type": "string",
              "format": "uuid"
            },
            "recipient_membership_id": {
              "type": "string",
              "format": "uuid"
