              "additionalProperties": false
            },
            "recipient_id": {
              "type": "string",
              "format": "uuid"
            },
            "recipient_membership_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "workspace_id",
            "task_id",
            "actor",
            "recipient_id",
            "recipient_membership_id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "schema_version",
        "producer",
        "occurred_at",
        "request_id",
        "aggregate_id",
        "aggregate_version",
        "data"
      ],
      "additionalProperties": false
    },
    "task_comment_mentioned_v1": {
      "type": "object",
      "properties": {
