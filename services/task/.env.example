# Local placeholders only. Copy to .env and replace the password before starting.
TASK_DB_URL=jdbc:postgresql://localhost:5433/task_db?currentSchema=task_service
TASK_DB_USERNAME=task_app
TASK_DB_PASSWORD=replace-with-a-local-password
IDENTITY_BASE_URL=http://localhost:8000
SERVER_PORT=8001
# Set the Task-specific key issued by Identity before using protected routes.
TASK_IDENTITY_SERVICE_KEY=
# At least 32 UTF-8 bytes, shared by all Task instances; use a random secret.
TASK_CURSOR_SECRET=
# Opt-in RabbitMQ publisher; provision infra/broker first and set the task user's secret.
TASK_OUTBOX_ENABLED=false
TASK_BROKER_HOST=localhost
TASK_BROKER_PORT=5672
TASK_BROKER_VHOST=taskmgn
TASK_BROKER_USERNAME=task
TASK_BROKER_PASSWORD=
TASK_BROKER_TLS=false
