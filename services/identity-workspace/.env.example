# scripts/setup_local_db.py generates an ignored .env and local password files.
# For an existing PostgreSQL installation, copy this file and supply its credentials/port.
# Password characters reserved in URLs must be percent-encoded.
IDENTITY_ENVIRONMENT=development
IDENTITY_LOG_LEVEL=INFO
IDENTITY_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
IDENTITY_DATABASE_URL=postgresql+psycopg://identity_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5434/identity_db

# Set the public Google OAuth web client ID to enable sign-in; never put a client secret here.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_TIMEOUT_SECONDS=2
IDENTITY_AUTH_CHALLENGE_LIMIT_PER_MINUTE=10
IDENTITY_AUTH_EXCHANGE_LIMIT_PER_MINUTE=30

# Private APIs: distinct 256-bit per-service secrets, provisioned separately.
# Leave unset to disable that caller. Configure a value OR a secret-file path.
# Prefer compose.private.yaml and scripts/setup_service_keys.py for local Docker.
IDENTITY_TASK_SERVICE_KEY=
IDENTITY_NOTIFICATION_SERVICE_KEY=
IDENTITY_TASK_SERVICE_KEY_FILE=
IDENTITY_NOTIFICATION_SERVICE_KEY_FILE=

# Connection attempts and pool waits are bounded; queries have a server-side limit.
IDENTITY_DB_CONNECT_TIMEOUT_SECONDS=2
IDENTITY_DB_POOL_TIMEOUT_SECONDS=2
IDENTITY_DB_STATEMENT_TIMEOUT_MS=2000
IDENTITY_DB_POOL_SIZE=5
IDENTITY_DB_MAX_OVERFLOW=0

# Optional separate outbox worker; unused by the HTTP application's readiness.
# Set URL OR a file containing it. Production requires amqps with system CA verification.
# Use percent-encoding for credentials/vhost; URL query parameters are rejected.
IDENTITY_BROKER_URL=
IDENTITY_BROKER_URL_FILE=
IDENTITY_BROKER_EXCHANGE=identity.lifecycle.v1
